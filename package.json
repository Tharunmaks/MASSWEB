{
  "name": "mass-web",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "dev:pages": "vite --config vite.pages.config.ts",
    "build:pages": "vite build --config vite.pages.config.ts",
    "preview:pages": "vite preview --config vite.pages.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.20.3",
    "@mozilla/readability": "^0.6.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/router-plugin": "^1.168.0",
    "@vitejs/plugin-react": "^5.2.0",
    "lightningcss": "^1.28.0",
    "linkedom": "^0.18.15",
    "lucide-react": "^0.510.0",
    "nitro": "3.0.260610-beta",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanitize-html": "^2.18.1",
    "tailwindcss": "^4.3.0",
    "turndown": "^7.2.5",
    "typescript": "^5.7.0",
    "vite": "^8.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.16.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/turndown": "^5.0.6",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "playwright": "^1.62.0",
    "prettier": "^3.4.0",
    "typescript-eslint": "^8.56.1"
  },
  "description": "Mass Web: a fast, private web browser for your phone and for AI agents"
}
